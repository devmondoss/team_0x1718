# Proveedor de LLM — decisión en docs/context/ale_dev/SPRINTS.md
# NUNCA commitear la key real: .env.local está en .gitignore
ANTHROPIC_API_KEY=sk-ant-...

# Niveles de modelo del runtime (lib/contracts/firmas.ts)
#   rapido -> Coordinador, Guardian, Detective
#   capaz  -> Auditor (solo casos pausados/escalados)
MODELO_RAPIDO=claude-haiku-5-5
MODELO_CAPAZ=claude-opus-5-5

# ── Modelo local con Ollama (todo en la Mac, sin API key ni costo) ──
# Si OLLAMA_MODELO existe, los agentes usan Ollama (gana sobre ANTHROPIC_API_KEY).
# Un solo modelo: dos grandes a la vez pueden no caber en memoria y Ollama se traba.
# Probado en Apple M5 24 GB: qwen3.5:9b o qwen2.5:7b → ~0,8 s por llamada, demo 8/8.
# OLLAMA_MODELO=qwen3.5:9b
# OLLAMA_THINK=false          # modelos con razonamiento: false | low | medium | high
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODELO_CAPAZ=        # opcional, solo para el Auditor
# OLLAMA_KEEP_ALIVE=60m

# 1 = los agentes devuelven salidas fijas por escenario, sin gastar tokens.
# Es lo que permite el demo end-to-end del SYNC 1 (hora 9).
AGENTS_MOCK=1

# ── Demo en la laptop (npm run servidor lo configura solo; ver README) ──
# Todas son opcionales. Sin ellas, el comportamiento es el de siempre.

# Token del operador: si existe, reiniciar el demo, confirmar mulas y borrar
# partidas exigen la cabecera x-demo-token. Obligatorio si se expone por red o
# túnel (npm run servidor -- --red / --tunel lo genera si falta).
# DEMO_TOKEN=

# 1 = modo juego: una transferencia PERMITIDA cuenta como movimiento de la
# cuenta destino y alimenta su fan-in (DEMO_JUEGO §9).
# MOVIMIENTOS_EN_VIVO=1

# Respaldo en archivo para que la Memoria y las partidas sobrevivan a un
# reinicio del proceso. La carpeta .datos/ está en .gitignore.
# MEMORIA_ARCHIVO=.datos/memoria.json
# PARTIDAS_ARCHIVO=.datos/partidas.json
# ARCADE_ARCHIVO=.datos/arcade.json

# ── Supabase (jugadores, partidas y ranking) ──
# Crea las tablas con supabase/migrations/*.sql (SQL Editor o `supabase db push`).
# La service_role key es SOLO del servidor: nunca en el navegador ni en el repo.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# ── Atomic Memory: notas de revisión del analista (opcional) ──
# El operador deja una nota sobre la cuenta destino y la ve en el próximo caso
# de esa cuenta. Es contexto: no es evidencia ni cambia la decisión.
# Exige las tres variables (sin DEMO_TOKEN no hay operador autenticado).
# La key es solo del servidor. Cloud: https://api.atomicstrata.ai
# ATOMICMEMORY_API_URL=https://api.atomicstrata.ai
# ATOMICMEMORY_API_KEY=
# ATOMICMEMORY_TIMEOUT_MS=2500   # opcional, entre 100 y 10000
